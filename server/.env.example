PORT=3001

# Connexion Postgres (locale ou Render/Railway). En local, le plus simple :
# docker run --name bar-a-prime-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=bar_a_prime -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bar_a_prime

# Pseudos (separes par des virgules) qui deviennent admin des leur creation de profil
ADMIN_PSEUDOS=Alex

# Solde de depart de chaque joueur
STARTING_BALANCE=1000

# Mise minimum autorisee par pari (aussi le montant impose par la mise
# obligatoire sur chaque pari ouvert, cf MandatoryBetGate cote frontend)
MIN_BET_AMOUNT=10
